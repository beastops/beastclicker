<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BeastClicker</AssemblyName>
    <RootNamespace>BeastClicker</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Coordinates must be real pixels on scaled displays, so opt into
         per-monitor DPI awareness rather than letting Windows virtualise us. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- A complete version resource is worth filling in even though nothing reads
       it at runtime. Reputation systems and antivirus heuristics treat an
       unsigned binary with blank publisher fields worse than an unsigned one
       that at least says who built it and what it is. -->
  <PropertyGroup Label="Metadata">
    <Version>3.1.0</Version>
    <Product>Beast Clicker</Product>
    <AssemblyTitle>Beast Clicker</AssemblyTitle>
    <Description>A precise, low-overhead auto clicker for Windows.</Description>
    <Company>BEASTXO</Company>
    <Authors>BEASTXO</Authors>
    <Copyright>Copyright (c) 2026 BEASTXO</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/zbeastcorp/beastclicker</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as well as stamped onto the exe, so the window and taskbar icon
         are available at runtime and not only to Explorer. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
